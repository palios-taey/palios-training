__pycache__/
*.pyc

# Mined correction candidates: regenerable from harvest_corrections.py, and contains
# unreviewed raw transcript text across all fleet projects. Curate before committing.
careers-qwen/data/corrections/candidates_*.jsonl

# Training DATA is PRIVATE — never public (Jesse 2026-07-22). Pair .jsonl live in the governed
# private store: treasurer/foundations/careers/training_data (jsonl gitignored there). Only the
# TOOLING (deriver, residue gate, schemas) + docs are public here.
careers-qwen/data/**/*.jsonl

# --- non-publishable: training DATA, model weights, telemetry, secrets (Jesse: not public) ---
# History still contains these + 4 leaked API keys -> the PUBLIC repo must be a FRESH init of the
# scrubbed tooling ONLY (conductor PRIVATE_TO_PUBLIC), not this history. This gitignore defines the
# clean tooling include-set going forward.
*.jsonl
*.csv
*.safetensors
*.pt
*.bin
*.ckpt
checkpoints*/
datasets/
audit/
**/tokenized_cache/

# Agent tool state — per-session, never shared work product
.claude/
AGENTS.md
careers-qwen/bake_module3.sh
.operator-identity-allow

# deployment topology — NEVER commit (see fleet.env.example)
fleet.env

# captured node telemetry — private data, never public
dense-9b/instrumentation/wedge_captures/

# TRAINING PAIRS ARE NEVER PUBLIC (Jesse, standing rule).
# This repo holds TOOLING and DOCUMENTATION only; every row lives in the private
# governed store under TRAINING_DATA_ROOT. A fixture is still a pair — the smoke
# fixture careers-qwen/fixtures/k_smoke.jsonl carried real work-history rows and
# was one push from being public. No exceptions, including test fixtures.
*.jsonl

# Driver logs from careers-qwen/run_stage2_sft_ddp_till_done.sh. Generated per launch,
# regenerable, and they name hosts — never commit them.
.sft_run_*.log
.sft_bake_*.log

# Per-checkpoint audit verdicts. PRODUCTION_MANIFEST lists these under missing_proof,
# but they carry a personal email in results.txt (caught by check_no_private_data.sh),
# and this repo is PUBLIC. They belong in the private archive repo, not here.
# Scrubbing them is not an option: rewriting audit evidence invalidates it as evidence.
docs/audit_results/
