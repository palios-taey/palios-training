{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lifecycle-chain.schema.json",
  "title": "Lifecycle observation chain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "observation_sha256"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "observation_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
