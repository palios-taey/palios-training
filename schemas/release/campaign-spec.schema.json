{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-spec.schema.json",
  "title": "Immutable campaign specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "transition",
    "content_sha",
    "consumer_plane"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "transition": {
      "type": "string",
      "enum": [
        "train",
        "bake",
        "promote"
      ]
    },
    "content_sha": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*//)(?!.*\\.\\./)(?!\\.\\.$)[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "consumer_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taey",
        "ep3"
      ],
      "properties": {
        "taey": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "ep3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
