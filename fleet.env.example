# fleet.env.example — PUBLIC template. Copy to fleet.env (gitignored) and fill in real values.
#
# WHY THIS EXISTS: the public repo is production INFRASTRUCTURE. Topology is NOT infrastructure,
# it is deployment configuration, and it must never be committed. Before this file, 49 scripts
# hardcoded fleet addresses and the push-gate only caught them at publish time — a gate at a
# boundary this branch never crossed, so 83 violations accumulated over 311 commits.
#
# Scripts should:   . "$(git rev-parse --show-toplevel)/fleet.env"
# and then use the variables below instead of literal addresses.

# Training cluster — management network (one per node, rank order)
SPARK_MGMT_IPS="PRIVATE_MGMT_IP_0 PRIVATE_MGMT_IP_1 PRIVATE_MGMT_IP_2 PRIVATE_MGMT_IP_3"
SPARK_MASTER="PRIVATE_MGMT_IP_0"          # rank 0, binds the torchrun rendezvous
SPARK_USER="spark"

# Training cluster — high-speed rail (torchrun master_addr / NCCL)
SPARK_RAIL_MASTER="PRIVATE_RAIL_IP_0"
SPARK_RAIL_IPS="PRIVATE_RAIL_IP_0 PRIVATE_RAIL_IP_1 PRIVATE_RAIL_IP_2 PRIVATE_RAIL_IP_3"

# Serving nodes
THOR1_ENDPOINT="PRIVATE_SERVE_HOST_1:8000"
THOR2_ENDPOINT="PRIVATE_SERVE_HOST_2:8000"

# Paths (node-local, not secret, but environment-specific)
SPARK_HOME="/home/<spark-node-account>"
SPARK_MODELS="${SPARK_HOME}/models"
SPARK_NODE1="PRIVATE_MGMT_IP_1"
SPARK_NODE2="PRIVATE_MGMT_IP_2"
SPARK_NODE3="PRIVATE_MGMT_IP_3"
SPARK_RAIL_IP="PRIVATE_RAIL_IP_1"
THOR1_HOST="PRIVATE_SERVE_HOST_1"
THOR2_HOST="PRIVATE_SERVE_HOST_2"
ORCHESTRATOR_IP="PRIVATE_ORCHESTRATOR_IP"
SPARK_SUBNET="PRIVATE_MGMT_SUBNET"

# Post-CPT Artifact-B lifecycle. The conversion image is locally pinned by immutable digest and
# contains the exact torch/transformers versions used by training. ARTIFACT_STORE is controller
# storage, never a Spark path.
POST_CPT_ARTIFACT_STORE="/home/<controller-account>/training-artifacts"
POST_CPT_CONVERT_SSH="<serving-node-account>@${THOR1_HOST}"
POST_CPT_CONVERT_ROOT="/home/<serving-node-account>/cpt-artifacts"
POST_CPT_GRAFT_BASE="/home/<serving-node-account>/serve-models/<1199-tensor-serving-base>"
POST_CPT_CONVERT_IMAGE="<convert-image>@sha256:<immutable-digest>"
POST_CPT_SANCTION="<corpus-owner> <sanction-record> <date>"
